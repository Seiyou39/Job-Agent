<% content_for :title, "履歴書編集 | Job Agent" %>
<div class="profile">
  <div class="page-header"><div class="page-title-wrap"><p class="eyebrow">Resume profile</p><h1>履歴書・経歴を編集</h1><p class="sub">保存した内容は、企業分析の際に自動で参照されます。</p></div></div>
  <div class="form-card">
    <%= form_with model: @user, url: profile_path, method: :patch do |f| %>
      <% if @user.errors.any? %><div class="error-message"><%= @user.errors.full_messages.to_sentence %></div><% end %>
      <div class="form-group"><%= f.label :resume_text, "履歴書 / 経歴" %><%= f.text_area :resume_text, placeholder: "専攻、スキル、プロジェクト経験、資格、自己PRなどを入力してください…" %></div>
      <div class="actions"><%= f.submit "保存する", class: "btn" %><%= link_to "キャンセル", root_path, class: "btn btn-secondary" %></div>
    <% end %>
  </div>
</div>
