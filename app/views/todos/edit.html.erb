<% content_for :title, "タスク編集 | Job Agent" %>
<div class="analyze">
  <div class="page-header"><div class="page-title-wrap"><p class="eyebrow">Edit task</p><h1>タスクを編集</h1><p class="sub">内容と優先度を更新します。</p></div></div>
  <div class="form-card">
    <%= form_with(model: [@todo_list, @todo], local: true) do |form| %>
      <div class="form-group"><%= form.label :task, "タスク内容" %><%= form.text_field :task, placeholder: "タスク内容" %></div>
      <div class="form-group"><%= form.label :priority, "優先度" %><%= form.select :priority, [["高", "high"], ["中", "medium"], ["低", "low"]], { include_blank: "選択してください" } %></div>
      <div class="form-actions"><%= form.submit "保存する", class: "btn" %><%= link_to "キャンセル", @todo_list, class: "btn btn-secondary" %></div>
    <% end %>
  </div>
</div>
