<% content_for :title, "パスワード再設定 | Job Agent" %>
<div class="auth-main">
  <div class="auth-card">
    <div class="auth-head"><h1 class="auth-title">パスワードを再設定</h1><p class="auth-sub">登録済みのメールアドレスに再設定用リンクを送信します。</p></div>
    <% if flash[:alert] %><div class="error-message"><%= flash[:alert] %></div><% end %>
    <%= form_with url: passwords_path do |form| %>
      <div class="form-group"><%= form.label :email_address, "メールアドレス" %><%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "name@example.com", value: params[:email_address] %></div>
      <div class="form-submit"><%= form.submit "再設定メールを送信", class: "btn auth-submit" %></div>
    <% end %>
    <div class="auth-links auth-links-center"><%= link_to "ログインへ戻る", new_session_path %></div>
  </div>
</div>
