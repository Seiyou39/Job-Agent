<% content_for :title, "ユーザー詳細 | Job Agent" %>
<div class="analyze"><div class="page-header"><div class="page-title-wrap"><p class="eyebrow">User detail</p><h1>ユーザー詳細</h1></div></div><section class="panel"><p class="label">メールアドレス</p><p style="font-weight:750;"><%= @user.email_address %></p><p class="label" style="margin-top:20px;">権限</p><span class="badge badge-ai"><%= @user.role %></span></section><div class="actions"><%= link_to "編集", edit_user_path(@user), class: "btn" %><%= link_to "一覧へ戻る", users_path, class: "btn btn-secondary" %><%= button_to "削除", @user, method: :delete, data: { turbo_confirm: "このユーザーを削除しますか？" }, class: "btn btn-danger" %></div></div>
